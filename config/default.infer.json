{
  "denyHostSuffixes": [
    "cdn.example.com",
    ".akamaihd.net",
    ".cloudfront.net",
    ".fastly.net",
    ".jsdelivr.net",
    ".unpkg.com",
    ".w3.org",
    ".schema.org"
  ],
  "denyHostKeywords": [
    "static.",
    "image-",
    "images.",
    "assets.",
    "fonts.",
    "stats.",
    "analytics.",
    "log.",
    "track."
  ],
  "denyPathSubstrings": [],
  "pathAliases": {},
  "callShapes": ["member", "direct", "config"],
  "importSources": [
    "@umijs/max",
    "umi",
    "@umijs/request",
    "axios",
    "umi-request"
  ],
  "httpWrappers": [
    {
      "callee": "$HTTP",
      "methods": {
        "get": "GET",
        "getP": "GET",
        "post": "POST",
        "postP": "POST",
        "postJson": "POST"
      }
    },
    {
      "callee": "http",
      "methods": {
        "get": "GET",
        "post": "POST",
        "put": "PUT",
        "delete": "DELETE",
        "patch": "PATCH"
      }
    },
    {
      "callee": "request",
      "methods": {
        "get": "GET",
        "post": "POST",
        "put": "PUT",
        "delete": "DELETE",
        "patch": "PATCH"
      }
    },
    {
      "callee": "api",
      "methods": {
        "get": "GET",
        "post": "POST",
        "put": "PUT",
        "delete": "DELETE",
        "patch": "PATCH"
      }
    },
    {
      "callee": "apiClient",
      "methods": {
        "get": "GET",
        "post": "POST",
        "put": "PUT",
        "delete": "DELETE",
        "patch": "PATCH"
      }
    }
  ]
}
